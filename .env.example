# ============================================================
# Trust Platform — variáveis de ambiente
# Copie este arquivo para `.env` e preencha. NUNCA commite o .env.
# Guia completo: docs/SETUP-SUPABASE.md
# ============================================================

# --- Banco de dados (Supabase) ---
# Session pooler (Connect → Session pooler; usuário é postgres.<ref>)
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Direct connection (para migrations; IPv6 — se não tiver, repita a DATABASE_URL)
DIRECT_DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# --- Supabase Storage ---
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplicação ---
NODE_ENV=development
API_PORT=3001

# --- JWT (ES256 — chaves geradas no Módulo 0) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min (IDN-003)
REFRESH_TOKEN_TTL_DAYS=30           # 30 dias (IDN-003)

# --- Transactional Outbox (opcionais; defaults no env.schema.ts) ---
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=10

# --- E-mail transacional: Brevo (decisão P6b 2026-08-08; usado a partir do IDN-002) ---
BREVO_API_KEY=
EMAIL_FROM=no-reply@trustplatform.com
